<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="@string/network_test_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_settled_title"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_settled_description" />
        <Button
            android:id="@+id/btn_network_settled_initial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_settled_initial" />
        <Button
            android:id="@+id/btn_network_settled_late"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_settled_late" />
        <Button
            android:id="@+id/btn_network_settled_leave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/network_settled_leave" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HttpsURLConnection Automatic Collection"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap a button to send an HTTPS request. The base URL must support /get, /post, and /status/404. Response previews appear only on this page. Filter RUM Resources by resource_collection_source=http_url_connection." />

        <EditText
            android:id="@+id/et_https_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="HTTPS base URL"
            android:text="https://httpbin.org" />

        <Button
            android:id="@+id/btn_https_get"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HTTPS GET /get" />

        <Button
            android:id="@+id/btn_https_post"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HTTPS POST /post" />

        <Button
            android:id="@+id/btn_https_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HTTPS 404 /status/404" />

        <TextView
            android:id="@+id/tv_https_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="monospace"
            android:text="Ready to send a request"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_normal_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/network_normal_request" />

        <Button
            android:id="@+id/btn_stream_upload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/network_stream_upload" />

        <Button
            android:id="@+id/btn_stream_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/network_stream_download" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/websocket_test_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/websocket_test_description" />

        <Button
            android:id="@+id/btn_websocket_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/websocket_test_success" />

        <Button
            android:id="@+id/btn_websocket_manual_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/websocket_test_manual_success" />

        <Button
            android:id="@+id/btn_websocket_reject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/websocket_test_reject" />

        <Button
            android:id="@+id/btn_websocket_invalid_upgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/websocket_test_invalid_upgrade" />

        <Button
            android:id="@+id/btn_websocket_tcp_failure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/websocket_test_tcp_failure" />

        <Button
            android:id="@+id/btn_websocket_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/websocket_test_close" />

        <TextView
            android:id="@+id/tv_websocket_test_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/resource_queue_repro_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/resource_queue_repro_description" />

        <EditText
            android:id="@+id/et_resource_queue_hold_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/resource_queue_hold_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:text="@string/resource_queue_default_hold_seconds" />

        <Button
            android:id="@+id/btn_resource_queue_repro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/resource_queue_repro_action" />

        <TextView
            android:id="@+id/tv_resource_queue_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:paddingBottom="24dp"
            android:text="@string/resource_queue_repro_initial_result"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
